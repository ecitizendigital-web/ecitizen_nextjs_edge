# Copy to .env.local for local work. On Vercel, add the same names under Project Settings > Environment Variables.
# Everything is optional: with no values the site builds and runs, analytics stay off, and the lead form
# answers "not configured" and offers the WhatsApp fallback.

# ---- Site -------------------------------------------------------------------
# Public URL, used for canonical links, sitemap and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://ecitizendigital.com
# Contact email shown across the site. The V6 README flagged hi@ecitizen.digital vs ecitizendigital.com: decide and set it here.
NEXT_PUBLIC_CONTACT_EMAIL=hi@ecitizen.digital
# Google Search Console HTML-tag verification token (the content="" value). Server-side only.
GOOGLE_SITE_VERIFICATION=

# ---- Analytics (public IDs, loaded only after the visitor accepts measurement) ------
# Leave a value empty to switch that tool off. With GTM set, GA4 is not loaded directly: configure it inside GTM.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ---- Lead form (SERVER-ONLY secrets: never prefix these with NEXT_PUBLIC_) ---------
# Option 1: forward each lead as JSON to a webhook (Google Apps Script, Zapier, Make, n8n, your CRM...).
LEAD_WEBHOOK_URL=
# Sent as the X-Lead-Secret header so your endpoint can reject forged requests.
LEAD_WEBHOOK_SECRET=
# Option 2: email each lead through Resend (https://resend.com). All three are needed.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
